# Normalise line endings in the repository to LF, whatever the machine.
#
# Without this, Windows checks out CRLF, Prettier is configured for LF,
# and every file looks modified to one tool or the other — which is how
# a repo ends up with commits that change nothing but line endings and
# hide the changes that matter.
* text=auto eol=lf

# Binary: never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp3 binary
*.woff binary
*.woff2 binary
*.zip binary

# Generated — keep it out of diffs and out of review
package-lock.json -diff linguist-generated
src/books/**/book.json -diff linguist-generated
